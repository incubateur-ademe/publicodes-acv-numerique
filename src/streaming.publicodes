streaming:
  titre: Visionnage d'une vidéo en streaming
  formule:
    somme:
      - streaming . terminaux
      - streaming . transmission
      - streaming . data center
      - streaming . content delivery network
  unité: gCO2e

streaming . durée:
  titre: Temps de visionnage
  question: Quelle est la durée de visionnage ?
  par défaut: 60
  unité: minute

streaming . durée en heure:
  formule: streaming . durée / 60 minute/h
  unité: h

streaming . qualité:
  titre: Qualité de la vidéo
  question: Quelle est la qualité de la vidéo ?
  avec:
    SD:
      titre: SD
    HD:
      titre: HD
    ultra HD:
      titre: 4K / Ultra HD
  une possibilité:
    - SD
    - HD
    - ultra HD
  par défaut: "'SD'"

streaming . qualité . débit:
  formule:
    variations:
      - si: streaming . qualité = 'SD'
        alors: 0.7
      - si: streaming . qualité = 'HD'
        alors: 3 
      - si: streaming . qualité = 'ultra HD'
        alors: 7
  unité: Go/h

streaming . taille:
  titre: Volume de données de la vidéo
  formule: streaming . durée en heure * streaming . qualité . débit
  unité: Go

streaming . appareil:
  titre: Appareil utilisé
  question: Sur quel appareil visionnez-vous la vidéo ?
  avec:
    ordinateur fixe et écran:
      titre: Ordinateur fixe et écran
    ordinateur portable:
      titre: Ordinateur portable
    tablette:
      titre: Tablette
    smartphone:
      titre: Smartphone
    téléviseur:
      titre: Téléviseur
    videoprojecteur:
      titre: videoprojecteur
    moyenne:
      titre: Mix moyen d'appareils
  une possibilité:
    - ordinateur fixe et écran
    - ordinateur portable
    - tablette
    - smartphone
    - téléviseur
    - videoprojecteur
    - moyenne
  par défaut: "'moyenne'"

streaming . réseau:
  titre: Type de réseau
  question: Quel type de réseau utilisez-vous ?
  avec:
    fixe:
      titre: Réseau fixe
    mobile:
      titre: Réseau mobile
  une possibilité:
    - fixe
    - mobile
  par défaut: "'mobile'"

streaming . terminaux:
  formule:
    somme:
      - streaming . terminaux . construction
      - streaming . terminaux . usage
  unité: gCO2e

streaming . terminaux . construction:
  valeur: construction réelle
  contexte:
    appareil par défaut: streaming . appareil
    durée en heure par défaut: streaming . durée en heure
    moyenne utilisation ordinateur et écran par défaut: streaming . appareil . moyenne utilisation ordinateur fixe et écran
    moyenne utilisation ordinateur portable par défaut: streaming . appareil . moyenne utilisation ordinateur portable
    moyenne utilisation tablette par défaut: streaming . appareil . moyenne utilisation tablette
    moyenne utilisation smartphone par défaut: streaming . appareil . moyenne utilisation smartphone
    moyenne utilisation TV par défaut: streaming . appareil . moyenne utilisation téléviseur
    moyenne utilisation videoprojecteur par défaut: streaming . appareil . moyenne utilisation videoprojecteur
  unité: gCO2e

streaming . terminaux . usage:
  valeur: usage réel
  contexte:
    appareil par défaut: streaming . appareil
    durée en heure par défaut: streaming . durée en heure
    moyenne utilisation ordinateur et écran par défaut: streaming . appareil . moyenne utilisation ordinateur fixe et écran
    moyenne utilisation ordinateur portable par défaut: streaming . appareil . moyenne utilisation ordinateur portable
    moyenne utilisation tablette par défaut: streaming . appareil . moyenne utilisation tablette
    moyenne utilisation smartphone par défaut: streaming . appareil . moyenne utilisation smartphone
    moyenne utilisation TV par défaut: streaming . appareil . moyenne utilisation téléviseur
    moyenne utilisation videoprojecteur par défaut: streaming . appareil . moyenne utilisation videoprojecteur
  unité: gCO2e

streaming . appareil . moyenne utilisation ordinateur fixe et écran:
  formule: 0%

streaming . appareil . moyenne utilisation ordinateur portable:
  formule: 18%

streaming . appareil . moyenne utilisation tablette:
  formule: 0%

streaming . appareil . moyenne utilisation smartphone:
  formule: 0%

streaming . appareil . moyenne utilisation téléviseur:
  formule: 82%

streaming . appareil . moyenne utilisation videoprojecteur:
  formule: 0%

streaming . transmission:
  valeur: transmission par défaut
  contexte:
    transmission par défaut . taille par défaut: streaming . taille
    transmission par défaut . réseau: streaming . transmission . réseau
  unité: gCO2e

streaming . transmission . réseau:
  formule:
    variations:
      - si: streaming . réseau = 'fixe'
        alors: "'fixe Go'"
      - si: streaming . réseau = 'mobile'
        alors: "'mobile Go'"
  par défaut: "'mobile Go'"

streaming . data center:
  formule:
    somme:
      - streaming . data center . construction
      - streaming . data center . transport
      - streaming . data center . usage
      - streaming . data center . fin de vie
  unité: gCO2e

streaming . data center . facteur d'allocation:
  formule: streaming . durée en heure * data center . nombre de serveur
  unité: serveur.an

streaming . data center . construction:
  formule: streaming . data center . facteur d'allocation * streaming . data center . construction unitaire
  unité: gCO2e

streaming . data center . transport:
  formule: streaming . data center . facteur d'allocation * streaming . data center . transport unitaire
  unité: gCO2e

streaming . data center . fin de vie:
  formule: streaming . data center . facteur d'allocation * streaming . data center . fin de vie unitaire
  unité: gCO2e

streaming . data center . usage:
  formule: streaming . durée en heure * streaming . data center . usage unitaire
  unité: gCO2e

streaming . data center . part cloud:
  formule: 75%

streaming . data center . part en propre:
  formule: 100% - streaming . data center . part cloud

streaming . data center . construction unitaire:
  formule: (streaming . data center . part en propre * data center . origine en propre . construction) + (streaming . data center . part cloud * data center . origine en cloud . construction)
  unité: gCO2e/serveur.an

streaming . data center . transport unitaire:
  formule: (streaming . data center . part en propre * data center . origine en propre . transport) + (streaming . data center . part cloud * data center . origine en cloud . transport)
  unité: gCO2e/serveur.an

streaming . data center . fin de vie unitaire:
  formule: (streaming . data center . part en propre * data center . origine en propre . fin de vie) + (streaming . data center . part cloud * data center . origine en cloud . fin de vie)
  unité: gCO2e/serveur.an

streaming . data center . usage unitaire:
  formule: (streaming . data center . part en propre * data center . origine en propre . usage) + (streaming . data center . part cloud * data center . origine en cloud . usage)
  unité: gCO2e/h

streaming . content delivery network:
  formule:
    somme:
      - streaming . content delivery network . construction
      - streaming . content delivery network . transport
      - streaming . content delivery network . usage
      - streaming . content delivery network . fin de vie
  unité: gCO2e

streaming . content delivery network . construction:
  formule: streaming . taille * content delivery network . construction
  unité: gCO2e

streaming . content delivery network . transport:
  formule: streaming . taille * content delivery network . transport
  unité: gCO2e

streaming . content delivery network . usage:
  formule: streaming . taille * content delivery network . usage
  unité: gCO2e

streaming . content delivery network . fin de vie:
  formule: streaming . taille * content delivery network . fin de vie
  unité: gCO2e

  
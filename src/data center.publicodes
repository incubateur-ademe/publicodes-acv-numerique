data center par défaut:
  formule:
    somme:
      - data center origine en propre France * (1 - part cloud)
      - data center origine en cloud dont étranger * part cloud
      - cdn
  unité: gCO2e

data center par défaut . part cloud:
  formule: 75%

data center par défaut . taille par défaut:
  formule: 50 Mo / 1000 Mo/Go
  unité: Go

data center par défaut . durée sollicitation par défaut:
  formule: taille par défaut / transmission par défaut . débit
  unité: h

data center par défaut . data center origine en propre France:
  formule:
    somme:
      - hors utilisation * durée sollicitation par défaut
      - utilisation * durée sollicitation par défaut
  unité: gCO2e

data center par défaut . data center origine en propre France . hors utilisation:
  valeur: 0.0412983562235556
  unité: gCO2e/h

data center par défaut . data center origine en propre France . utilisation:
  valeur: 0.0750998443076434
  unité: gCO2e/h

data center par défaut . data center origine en cloud dont étranger:
  formule:
    somme:
      - hors utilisation * durée sollicitation par défaut
      - utilisation * durée sollicitation par défaut
  unité: gCO2e

data center par défaut . data center origine en cloud dont étranger . hors utilisation:
  valeur: 0.0412983562235556
  unité: gCO2e/h

data center par défaut . data center origine en cloud dont étranger . utilisation:
  valeur: 0.629230026753547
  unité: gCO2e/h

data center par défaut . cdn:
  formule:
    somme:
      - hors utilisation * taille par défaut
      - utilisation * taille par défaut
  unité: gCO2e


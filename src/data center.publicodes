data center:
  unité: gCO2e
  note: par heure

data center . consommation électrique:
  formule: 0.68
  unité: Wh/h

data center . nombre de serveur:
  formule: 0.000000212181573260480
  unité: serveur.an/h

data center . origine en propre:
  formule:
    somme:
      - data center . origine en propre . construction
      - data center . origine en propre . transport
      - data center . origine en propre . usage
      - data center . origine en propre . fin de vie
  unité: gCO2e

data center . origine en propre . construction:
  formule: 0.11685
  unité: gCO2e

data center . origine en propre . transport:
  formule: 0.00564
  unité: gCO2e

data center . origine en propre . usage:
  formule: 0.04547
  unité: gCO2e

data center . origine en propre . fin de vie:
  formule: 0.00420
  unité: gCO2e

data center . origine en cloud:
  formule:
    somme:
      - data center . origine en cloud . construction
      - data center . origine en cloud . transport
      - data center . origine en cloud . usage
      - data center . origine en cloud . fin de vie
  unité: gCO2e

data center . origine en cloud . construction:
  formule: 0.11685
  unité: gCO2e

data center . origine en cloud . transport:
  formule: 0.00564
  unité: gCO2e

data center . origine en cloud . usage:
  formule: 0.24121
  unité: gCO2e

data center . origine en cloud . fin de vie:
  formule: 0.00420
  unité: gCO2e

data center . origine en cloud . pourcentage FR:
  formule: 30%

data center . origine en cloud . pourcentage US:
  formule: 35%

data center . part cloud:
  formule: 75%

data center . part en propre:
  formule: 100% - data center . part cloud

data center . impact moyen:
  formule:
    somme:
      - data center . impact moyen . en propre
      - data center . impact moyen . cloud
  unité: gCO2e

data center . impact moyen . en propre:
  formule: data center . part en propre * data center . origine en propre
  unité: gCO2e

data center . impact moyen . cloud:
  formule: data center . part cloud * data center . origine en cloud
  unité: gCO2e
  
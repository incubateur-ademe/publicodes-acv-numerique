transmission par défaut:
  formule: taille par défaut * facteur réseau
  unité: gCO2e

transmission par défaut . taille par défaut:
  par défaut: 0
  unité: Go

transmission par défaut . réseau par défaut:
  par défaut: "'fixe Go'"

transmission par défaut . facteur réseau:
  formule:
    variations:
      - si: réseau par défaut = 'fixe Go'
        alors: facteur réseau fixe Go
      - si: réseau par défaut = 'mobile Go'
        alors: facteur réseau mobile Go
  unité: gCO2e/Go

transmission par défaut . facteur réseau fixe Go:
  formule: 0.956370508
  unité: gCO2e/Go
  note: Étude ADEME 2024, "Etude de l'impact environnemental des usages audiovisuels en France" https://librairie.ademe.fr/economie-circulaire-et-dechets/7667-etude-de-l-impact-environnemental-des-usages-audiovisuels-en-france.html#

transmission par défaut . facteur réseau mobile Go:
  formule: 9.571624339
  unité: gCO2e/Go
  note: Étude ADEME 2024, "Etude de l'impact environnemental des usages audiovisuels en France" https://librairie.ademe.fr/economie-circulaire-et-dechets/7667-etude-de-l-impact-environnemental-des-usages-audiovisuels-en-france.html#

transmission autre:
  formule: taille autre * facteur réseau autre
  unité: gCO2e

transmission autre . taille autre:
  par défaut: 0
  unité: h

transmission autre . facteur réseau autre:
  formule:
    variations:
      - si: réseau autre = 'fixe heure'
        alors: facteur réseau fixe heure
      - si: réseau autre = 'mobile heure'
        alors: facteur réseau mobile heure
  unité: gCO2e/h

transmission autre . facteur réseau fixe heure:
  formule: 5.117087337
  unité: gCO2e/h
  note: Étude ADEME 2024, "Etude de l'impact environnemental des usages audiovisuels en France" https://librairie.ademe.fr/economie-circulaire-et-dechets/7667-etude-de-l-impact-environnemental-des-usages-audiovisuels-en-france.html#

transmission autre . facteur réseau mobile heure:
  formule: 7.031758714
  unité: gCO2e/h
  note: |
    Étude ADEME 2024 "Etude de l'impact environnemental des usages audiovisuels en France" https://librairie.ademe.fr/economie-circulaire-et-dechets/7667-etude-de-l-impact-environnemental-des-usages-audiovisuels-en-france.html#
  